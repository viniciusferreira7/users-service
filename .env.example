NODE_ENV=dev
PORT=3334
# How long the readiness probe fails before the server closes on SIGTERM.
SHUTDOWN_DRAIN_DELAY_MS=10000

# Database
# The `DATABASE_*` parts below provision the `docker-compose.yaml` Postgres
# container; `DATABASE_URL` is what TypeORM actually connects with, so keep the
# two in sync.
DATABASE_URL="postgres://postgres:postgres@localhost:5435/users_db"
DATABASE_PORT=5435
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=users_db

# Test infrastructure (docker compose `test` profile) — a throwaway Postgres
# the int/e2e lanes connect to, kept apart from the dev one on 5435.
DATABASE_TEST_PORT=5436
DATABASE_TEST_USERNAME=test
DATABASE_TEST_PASSWORD=test
DATABASE_TEST_NAME=users_db_test

# Observability (@viniciusferreira7/signals)
# These are read by the `--require @viniciusferreira7/signals/register` preload,
# which runs BEFORE Nest's ConfigModule loads this file. Exporting them in the
# real process environment is therefore required; the entries here document the
# expected values and feed the non-preload fallback path.
OTEL_SERVICE_NAME=users-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=debug

# JWT
# Must be the SAME value configured in the api-gateway, which verifies the
# tokens this service signs. At least 32 characters; generate one with
# `openssl rand -hex 32`. Left empty on purpose: the service refuses to boot
# until a real secret is set.
JWT_SECRET=
